#include <iostream>

int main() {
    std::cout << "--- 12일차 배열과 반복문: 최댓값/최솟값 구하기 ---" << std::endl;

    int scores[6] = { 45, 89, 92, 63, 78, 95 };
    int arraySize = 6;

    // 1. 첫 번째 값을 기준(최댓값/최솟값 후보)으로 잡습니다.
    int maxVal = scores[0];
    int minVal = scores[0];

    // 2. 반복문을 돌며 배열의 나머지 값들과 비교합니다.
    for (int i = 1; i < arraySize; i++) {
        // 더 큰 값을 만나면 maxVal 갱신
        if (scores[i] > maxVal) {
            maxVal = scores[i];
        }
        // 더 작은 값을 만나면 minVal 갱신
        if (scores[i] < minVal) {
            minVal = scores[i];
        }
    }

    // 결과 출력
    std::cout << "학생들의 전체 점수: { 45, 89, 92, 63, 78, 95 }" << std::endl;
    std::cout << "-----------------------------------" << std::endl;
    std::cout << "🏆 최고 점수 (Max): " << maxVal << "점" << std::endl;
    std::cout << "💧 최저 점수 (Min): " << minVal << "점" << std::endl;

    return 0;
}
