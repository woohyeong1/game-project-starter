#include <iostream>

int main() {
    std::cout << "--- 13일차 별 찍기 패턴 실습 ---" << std::endl;

    int n = 5; // 출력할 줄 수

    // 1. 직각 삼각형 모양으로 별 찍기
    std::cout << "\n[1] 직각 삼각형" << std::endl;
    for (int i = 1; i <= n; i++) {           // i가 1부터 5까지 증가 (총 5줄)
        for (int j = 1; j <= i; j++) {       // i번째 줄에는 별을 i개 출력
            std::cout << "* ";
        }
        std::cout << std::endl;              // 한 줄 출력 끝난 후 줄바꿈
    }

    // 2. 역직각 삼각형 모양으로 별 찍기
    std::cout << "\n[2] 역직각 삼각형" << std::endl;
    for (int i = n; i >= 1; i--) {           // i가 5부터 1까지 감소
        for (int j = 1; j <= i; j++) {       // i개만큼 별 출력
            std::cout << "* ";
        }
        std::cout << std::endl;
    }

    return 0;
}
