#include <iostream>

int main() {
    int sum = 0; // 합계를 저장할 변수

    std::cout << "--- 8일차 for문 실습: 1부터 10까지의 합 구하기 ---" << std::endl;

    // for문을 이용해 1부터 10까지 반복
    for (int i = 1; i <= 10; i++) {
        sum += i; // sum = sum + i 와 같은 의미입니다.
        std::cout << "현재 i 값: " << i << ", 현재까지의 합: " << sum << std::endl;
    }

    std::cout << "\n[최종 결과]" << std::endl;
    std::cout << "1부터 10까지의 총합은 " << sum << " 입니다." << std::endl;

    return 0;
}
