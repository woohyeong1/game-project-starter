#include "Player.h"
#include <iostream>
#include <fstream>

Player::Player(const std::string& playerName, int lv, int startGold)
    : name(playerName), level(lv), gold(startGold) {
}

std::string Player::getName() const {
    return name;
}

int Player::getGold() const {
    return gold;
}

int Player::getItemCount(const std::string& itemName) const {
    auto it = inventory.find(itemName);
    if (it == inventory.end()) {
        return 0;
    }
    return it->second;
}

void Player::addItem(const std::string& itemName, int count) {
    if (count <= 0) return;
    inventory[itemName] += count;
    logs.push_back("아이템 획득: " + itemName + " x" + std::to_string(count));
}

bool Player::removeItem(const std::string& itemName, int count) {
    if (count <= 0) return false;
    auto it = inventory.find(itemName);
    if (it == inventory.end() || it->second < count) {
        return false;
    }
    it->second -= count;
    if (it->second == 0) {
        inventory.erase(it);
    }
    logs.push_back("아이템 소모/판매: " + itemName + " x" + std::to_string(count));
    return true;
}

void Player::earnGold(int amount) {
    if (amount <= 0) return;
    gold += amount;
    logs.push_back("골드 획득: +" + std::to_string(amount) + "G");
}

bool Player::spendGold(int amount) {
    if (amount <= 0 || gold < amount) {
        return false;
    }
    gold -= amount;
    logs.push_back("골드 지출: -" + std::to_string(amount) + "G");
    return true;
}

void Player::levelUp() {
    level++;
    logs.push_back("레벨 업! 현재 Lv." + std::to_string(level));
}

void Player::showStatus() const {
    std::cout << "\n========== [플레이어 상태] ==========" << std::endl;
    std::cout << "이름: " << name << " | 레벨: Lv." << level << " | 골드: " << gold << "G" << std::endl;
    std::cout << "--- 인벤토리 ---" << std::endl;
    if (inventory.empty()) {
        std::cout << "  (비어 있음)" << std::endl;
    }
    else {
        for (const auto& pair : inventory) {
            std::cout << "  - " << pair.first << ": " << pair.second << "개" << std::endl;
        }
    }
    std::cout << "--- 최근 로그 ---" << std::endl;
    for (const auto& entry : logs) {
        std::cout << "  * " << entry << std::endl;
    }
    std::cout << "====================================" << std::endl;
}

bool Player::saveToFile(const std::string& filename) const {
    std::ofstream out(filename);
    if (!out.is_open()) {
        return false;
    }

    out << "PLAYER " << name << " " << level << " " << gold << "\n";
    out << "ITEMS " << inventory.size() << "\n";
    for (const auto& pair : inventory) {
        out << pair.first << " " << pair.second << "\n";
    }

    out.close();
    return true;
}

bool Player::loadFromFile(const std::string& filename) {
    std::ifstream in(filename);
    if (!in.is_open()) {
        return false;
    }

    std::string header;
    if (!(in >> header) || header != "PLAYER") {
        return false;
    }

    in >> name >> level >> gold;

    std::string itemHeader;
    size_t itemCount = 0;
    if ((in >> itemHeader >> itemCount) && itemHeader == "ITEMS") {
        inventory.clear();
        for (size_t i = 0; i < itemCount; i++) {
            std::string itemName;
            int count = 0;
            if (in >> itemName >> count) {
                inventory[itemName] = count;
            }
        }
    }

    logs.clear();
    logs.push_back("세이브 파일 '" + filename + "' 불러오기 완료");
    in.close();
    return true;
}
