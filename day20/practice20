#include <iostream>
#include <string>

// 1. 클래스 정의 (플레이어 설계도)
class Player {
private:
    std::string name; // 외부에서 직접 접근할 수 없는 비공개 변수
    int hp;
    int level;

public:
    // 생성자 (Constructor): 객체가 생성될 때 자동으로 호출되는 초기화 함수
    Player(std::string playerName, int playerHp, int playerLevel) {
        name = playerName;
        hp = playerHp;
        level = playerLevel;
    }

    // 멤버 함수: 플레이어 정보 출력
    void showInfo() {
        std::cout << "[플레이어 정보] 이름: " << name << " | 레벨: " << level << " | 체력: " << hp << std::endl;
    }

    // 멤버 함수: 공격하기
    void attack() {
        std::cout << name << "이(가) 적을 공격합니다! ⚔️" << std::endl;
    }

    // 멤버 함수: 데미지 입기
    void takeDamage(int damage) {
        hp -= damage;
        if (hp < 0) hp = 0;
        std::cout << name << "이(가) " << damage << "의 피해를 입었습니다! (남은 체력: " << hp << ")" << std::endl;
    }
};

int main() {
    std::cout << "--- 20일차 클래스와 객체 실습 (게임 플레이어 만들기) ---" << std::endl;

    // 2. 객체 생성 (인스턴스화)
    // 설계도(Player)를 바탕으로 '전사'와 '마법사' 실물 객체를 만듭니다.
    Player warrior("철수전사", 100, 1);
    Player mage("영희마법사", 80, 1);

    // 3. 객체의 멤버 함수 호출하기
    warrior.showInfo();
    mage.showInfo();

    std::cout << "\n[전투 시작!]" << std::endl;
    warrior.attack();
    mage.takeDamage(30);

    std::cout << "\n[전투 후 상태]" << std::endl;
    mage.showInfo();

    return 0;
}
