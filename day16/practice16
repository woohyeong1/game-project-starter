#include <iostream>

// 1. 값 전달(Call by Value): 복사본을 가져오므로 원본이 안 바뀜
void modifyByValue(int num) {
    num = 100;
    std::cout << "  -> [함수 내부] modifyByValue 안의 num 값: " << num << std::endl;
}

// 2. 참조 전달(Call by Reference): 원본의 별칭(&)을 가져오므로 원본이 바뀜
void modifyByReference(int& num) {
    num = 100;
    std::cout << "  -> [함수 내부] modifyByReference 안의 num 값: " << num << std::endl;
}

int main() {
    std::cout << "--- 16일차 값 전달 vs 참조 전달 실습 ---" << std::endl;

    // --- 실습 1: 값 전달 ---
    int originalA = 10;
    std::cout << "\n[1] 값 전달 테스트 (Before)" << std::endl;
    std::cout << "originalA의 원래 값: " << originalA << std::endl;

    modifyByValue(originalA); // 원본이 아니라 '복사본'이 넘어감

    std::cout << "[1] 값 전달 테스트 (After)" << std::endl;
    std::cout << "modifyByValue 호출 후 originalA의 값: " << originalA << " (바뀌지 않음!)" << std::endl;

    // --- 실습 2: 참조 전달 ---
    int originalB = 10;
    std::cout << "\n[2] 참조 전달 테스트 (Before)" << std::endl;
    std::cout << "originalB의 원래 값: " << originalB << std::endl;

    modifyByReference(originalB); // 원본의 참조(&)가 넘어감

    std::cout << "[2] 참조 전달 테스트 (After)" << std::endl;
    std::cout << "modifyByReference 호출 후 originalB의 값: " << originalB << " (바뀜!)" << std::endl;

    return 0;
}
