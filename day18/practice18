#include <iostream>

int main() {
    std::cout << "--- 18일차 포인터와 배열의 관계 실습 ---" << std::endl;

    int numbers[3] = { 10, 20, 30 };

    // 1. 배열의 이름과 첫 번째 원소의 주소 비교하기
    std::cout << "numbers 배열의 이름(주소): " << numbers << std::endl;
    std::cout << "numbers[0]의 주소(&):     " << &numbers[0] << std::endl;

    // 2. 포인터 변수에 배열 이름 대입하기
    int* ptr = numbers; // &numbers[0]과 완벽하게 같습니다.

    // 3. 포인터 연산과 역참조를 이용해 배열 순회하기
    std::cout << "\n[포인터 연산으로 배열 값 접근하기]" << std::endl;
    for (int i = 0; i < 3; i++) {
        // *(ptr + i)는 배열의 numbers[i]와 정확히 똑같이 작동합니다!
        std::cout << "*(ptr + " << i << ") = " << *(ptr + i) << std::endl;
        
        // 주소값이 4바이트(int 크기)씩 증가하는 것도 확인할 수 있습니다.
        std::cout << "  (해당 주소: " << (ptr + i) << ")" << std::endl;
    }

    return 0;
}
