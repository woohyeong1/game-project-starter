#include <iostream>

int main() {
    int menuChoice = 0;

    std::cout << "--- 5일차 switch-case 실습 (자판기 메뉴) ---" << std::endl;
    std::cout << "1. 콜라 (1500원)" << std::endl;
    std::cout << "2. 사이다 (1500원)" << std::endl;
    std::cout << "3. 물 (1000원)" << std::endl;
    std::cout << "원하시는 메뉴 번호를 입력하세요: ";
    std::cin >> menuChoice;

    // switch문으로 메뉴 분기
    switch (menuChoice) {
    case 1:
        std::cout << "콜라를 선택하셨습니다. 가격은 1500원입니다." << std::endl;
        break; // switch문을 빠져나감
    case 2:
        std::cout << "사이다를 선택하셨습니다. 가격은 1500원입니다." << std::endl;
        break;
    case 3:
        std::cout << "물을 선택하셨습니다. 가격은 1000원입니다." << std::endl;
        break;
    default: // 지정한 case 외의 숫자를 입력했을 때 (if문의 else 역할)
        std::cout << "잘못된 번호입니다. 올바른 메뉴를 선택해주세요." << std::endl;
        break;
    }

    return 0;
}
