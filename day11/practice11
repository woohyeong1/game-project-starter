#include <iostream>

int main() {
    std::cout << "--- 11일차 1차원 배열 실습 ---" << std::endl;

    // 1. 크기가 5인 정수형 배열 선언 및 초기화
    int scores[5] = { 85, 90, 78, 92, 88 };

    // 2. 반복문과 배열을 함께 사용하여 모든 요소 출력하기
    // 인덱스는 0부터 시작하므로 i는 0부터 4까지 반복합니다.
    std::cout << "학생들의 시험 점수 목록:" << std::endl;
    for (int i = 0; i < 5; i++) {
        std::cout << (i + 1) << "번 학생 점수: " << scores[i] << "점" << std::endl;
    }

    // 3. 특정 인덱스의 값 직접 변경해보기
    scores[2] = 95; // 3번째 학생(인덱스 2)의 점수를 95점으로 수정
    std::cout << "\n[3번째 학생 점수 수정 후]" << std::endl;
    std::cout << "3번 학생의 새로운 점수: " << scores[2] << "점" << std::endl;

    return 0;
}
