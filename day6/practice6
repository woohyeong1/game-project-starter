#include <iostream>

int main() {
    double num1 = 0.0;
    double num2 = 0.0;
    char op = ' ';

    std::cout << "--- 6일차 미니 프로젝트: 간단한 계산기 ---" << std::endl;
    
    // 1. 첫 번째 숫자 입력
    std::cout << "첫 번째 숫자를 입력하세요: ";
    std::cin >> num1;

    // 2. 연산자 입력 (+, -, *, /)
    std::cout << "연산자를 입력하세요 (+, -, *, /): ";
    std::cin >> op;

    // 3. 두 번째 숫자 입력
    std::cout << "두 번째 숫자를 입력하세요: ";
    std::cin >> num2;

    std::cout << "\n[연산 결과]" << std::endl;

    // 4. 연산자에 따른 분기 처리 (switch문 활용)
    switch (op) {
    case '+':
        std::cout << num1 << " + " << num2 << " = " << (num1 + num2) << std::endl;
        break;
    case '-':
        std::cout << num1 << " - " << num2 << " = " << (num1 - num2) << std::endl;
        break;
    case '*':
        std::cout << num1 << " * " << num2 << " = " << (num1 * num2) << std::endl;
        break;
    case '/':
        // 0으로 나누는 예외 상황 방지
        if (num2 == 0) {
            std::cout << "오류: 0으로 나눌 수 없습니다!" << std::endl;
        } else {
            std::cout << num1 << " / " << num2 << " = " << (num1 / num2) << std::endl;
        }
        break;
    default:
        std::cout << "오류: 잘못된 연산자입니다. (+, -, *, / 중 하나를 입력하세요)" << std::endl;
        break;
    }

    return 0;
}
